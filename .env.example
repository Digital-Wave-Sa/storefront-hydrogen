# Saadeddin Storefront — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and holds live credentials:
# never commit it, and never paste its contents into a chat, an issue or a PR.
# If a value leaks, rotate it in the issuing service — removing it from the
# file is not enough.
#
# PUBLIC_* is exposed to the browser. Everything else is server-only and must
# never be imported into a client component.
#
# Values come from a maintainer or from the Oxygen environment settings in the
# Shopify admin.

# ── Shopify: storefront ──────────────────────────────────────────────────────
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PUBLIC_CHECKOUT_DOMAIN=
PUBLIC_SHOPIFY_STORE_DOMAIN=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_SHOP=
SHOPIFY_MARKET_ID=

# Session cookie signing key. Any long random string; changing it signs
# everyone out.
SESSION_SECRET=

# ── Shopify: customer accounts (OAuth) ───────────────────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ── Shopify: Admin API ───────────────────────────────────────────────────────
# Per-location inventory, order history, discounts and draft orders — none of
# which the Storefront API can answer. Server-side only.
SHOPIFY_ADMIN_DOMAIN=
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
SHOPIFY_ADMIN_API_ACCESS_TOKENS=

# ── Saadeddin backend services ───────────────────────────────────────────────
# Order middleware; gift-card codes and transaction history, keyed by phone.
MIDDLEWARE_URL=https://api.saadeddin.top

# Store credit — the AUTHORITATIVE wallet balance, keyed by customer id.
# Not the same service as MIDDLEWARE_URL; the two can disagree.
STORE_CREDIT_API_URL=https://sdgc.saadeddin.top

# Loyalty points and tiers.
PUBLIC_SDLP_APP_URL=https://sdlp.saadeddin.top
SDLP_APP_URL=https://sdlp.saadeddin.top

# CRM (OTP verification, customer profiles).
CRM_API_URL=
CRM_API_KEY=
SAADEDDIN_CRM_API_URL=
SAADEDDIN_CRM_API_KEY=

CUSTOM_API_URL=

# ── SMS (OTP) ────────────────────────────────────────────────────────────────
# The provider currently rejects non-+966 numbers.
SMS_API_URL=
SMS_API_USERNAME=
SMS_API_PASSWORD=

# ── Email ────────────────────────────────────────────────────────────────────
# sendEmail() tries three transports in order and returns false, silently, if
# all three are unavailable. WHICH ONES WORK DEPENDS ON WHERE YOU DEPLOY.
#
# 1. SMTP via nodemailer. Needs raw TCP sockets (net/tls), which Oxygen's
#    workerd runtime does not provide, so on Oxygen this path always fails and
#    falls through. Useful locally and on Node hosts only.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
#
# 2. Microsoft Graph. Plain HTTPS, so this is the transport that actually
#    delivers on Oxygen. Without these set, no contact form, custom request,
#    corporate enquiry, export enquiry or back-in-stock email leaves the site
#    in production — and nothing surfaces the failure to the customer.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
#
# 3. Resend. Also HTTPS; the last fallback.
RESEND_API_KEY=
FORM_EMAIL_FROM=

# Where form submissions are delivered.
CONTACT_RECEIVER_EMAIL=
FORM_EMAIL_RECIPIENT=
FORM_WEBHOOK_URL=

# ── Social sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=

# ── Google Maps (branch selection, delivery ranges) ──────────────────────────
PUBLIC_GOOGLE_MAPS_KEY=
PUBLIC_GOOGLE_PLACES_KEY=
PUBLIC_GOOGLE_GEOCODING_KEY=
PUBLIC_GOOGLE_DISTANCE_MATRIX_KEY=

# ── Analytics ────────────────────────────────────────────────────────────────
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GTM_ID=
PUBLIC_SMILE_CHANNEL_KEY=

# ── Aramex (export shipping) ─────────────────────────────────────────────────
ARAMEX_USERNAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=
ARAMEX_ACCOUNT_COUNTRY_CODE=

# ── Other ────────────────────────────────────────────────────────────────────
STOQ_MARKET_ID=
PUBLIC_STOQ_MARKET_ID=
NODE_ENV=development
